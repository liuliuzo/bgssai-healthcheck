<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- stdout log for local test-->
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level [%X{reqId:-}] [%X{uid:-}] %logger{100} - %msg%n</pattern>
        </encoder>
    </appender>

    <logger name="java.sql" level="INFO"/>
    <logger name="org.apache.ibatis" level="INFO"/>
    <logger name="org.mybatis.spring" level="INFO"/>

    <logger name="java.sql.Statement" level="INFO" additivity="false">
        <appender-ref ref="STDOUT"/>
    </logger>
    <logger name="org.apache.ibatis.logging.jdbc.BaseJdbcLogger" level="INFO" additivity="false">
        <appender-ref ref="STDOUT"/>
    </logger>
    <logger name="com.bgssai.geo.cn" level="INFO" additivity="false">
        <appender-ref ref="STDOUT"/>
    </logger>
    <root level="INFO">
        <appender-ref ref="STDOUT"/>
    </root>
</configuration>
